{
    "$schema": "https://ui.shadcn.com/schema.json",
    "style": "base-nova",
    "rsc": false,
    "tsx": true,
    "tailwind": {
        "config": "",
        "css": "src/client/index.css",
        "baseColor": "neutral",
        "cssVariables": true,
        "prefix": ""
    },
    "iconLibrary": "phosphor",
    "rtl": false,
    "aliases": {
        "components": "@/client/components",
        "utils": "@/client/core/lib/utils",
        "ui": "@/client/components/ui",
        "lib": "@/client/core/lib",
        "hooks": "@/client/core/hooks"
    },
    "menuColor": "default",
    "menuAccent": "subtle",
    "registries": {
        "@zippystarter": "https://zippystarter.com/r/{name}.json",
        "@reui": "https://reui.io/r/{style}/{name}.json",
        "@animate-ui": "https://animate-ui.com/r/{name}.json"
    }
}
